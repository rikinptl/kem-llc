# Firebase (public client config — safe in frontend, restrict in Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Portal access — production source of truth is Vercel env (not committed to git).
# Onboard via GitHub Action: .github/workflows/onboard-portal-user.yml
# Local dev: copy from Vercel or set manually in .env.local (gitignored).
VITE_ALLOWED_EMAILS=
VITE_OWNER_EMAILS=
VITE_COLLEAGUE_EMAILS=

# Server-side mirrors of the lists above
OWNER_EMAILS=
COLLEAGUE_EMAILS=
FIREBASE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_URL=
OWNER_GITHUB_TOKEN=
OWNER_GITHUB_REPO=rikinptl/web-auto
GITHUB_ACTIONS_URL=https://github.com/rikinptl/web-auto/actions/workflows/deploy.yml
DEEPSEEK_API_KEY=
DEPLOY_ORG=kem-llc

# Optional: extra CORS origins for API routes (comma-separated)
# ALLOWED_ORIGINS=https://preview.example.vercel.app

# GCP project for scripts (NOT for OAuth verification codes)
GCP_PROJECT_ID=kem-llc-web
GCP_PROJECT_NUMBER=
FIREBASE_WEB_APP_ID=
FIREBASE_HOSTING_SITE=kem-llc-web
BILLING_ALERT_EMAIL=kem.sales.us@gmail.com

# CLI: use `gcloud auth login` — scripts/firebase-gcp.sh uses gcloud token
# Firebase MCP: uses ADC from ~/.config/gcloud/application_default_credentials.json
#   Run once: ./scripts/firebase-auth-setup.sh  (or gcloud auth application-default login)
# Optional FIREBASE_TOKEN from `firebase login:ci` — add to .env.local if ADC is insufficient (never commit)
